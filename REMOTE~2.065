<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<%@  language="VBSCRIPT"%>
<%
'<EMBED> tag
'http://docs.oracle.com/javase/6/docs/technotes/guides/plugin/developer_guide/using_tags.html
'------------------------------------------------------------------------------
'Firefox
'Unable to find source/method to specifically make Firefox to download specific
'Java version and update. 
'
'attribute type="application/x-java-applet;version=X.X"
'The browser will not prompt for plug-in installation if the installed version
'is newer than the specified X.X".
'
'attribute type="application/x-java-applet;jpi-version=X.X.X_XX"
'The browser will follow exactly the specified version and prompt for plug-in
'installation no matter the PC installed version is newer or older.
'
'If the Java plug-in is disabled from the browser, navigator.javaEnabled() 
'returns false.
'The fail message in the EMBED tag will never show if the plug-in for installage
'message appear  
'
'Google Chrome
'attribute "type", value "application/x-java-applet;version=X.X"
'attribute "type", value "application/x-java-applet;jpi-version=X.X.X_XX"
'No matter which style, Google Chrome doesn't seems to care.  If the installed
'JRE is out date compare to the online available version, you will get a prompt 
'to install the latest or just run it.
'
'If the Java plug-in is disabled from the browser, navigator.javaEnabled() 
'returns true.  Nothing will get shown.
'
'<OBJECT> tag
'------------------------------------------------------------------------------
'Microsoft Internet Explorer
'If the JRE installed is newer than requested, it does nothing.
'attribute classid="clsid:CAFEEFAC-0016-0000-0018-ABCDEFFEDCBA"
'attribute codebase="http://java.sun.com/update/1.6.0/jinstall-6u18-windows-i586.cab"
'attribute classid is what cause the checking for minimum version required and
'codebase is where the latest installer could be downloaded or auto install.
'
'<PARAM NAME="type" VALUE="application/x-java-applet;jpi-version=1.6.0_18">'
'This doesn't seems to have any effect on IE.
'
'Java Applet Caching
'http://download.oracle.com/javase/6/docs/technotes/guides/plugin/developer_guide/applet_caching.html
'------------------------------------------------------------------------------
'archive, cache_option, cache_archive, cache_version
'The cache engine will replace the older jar file with a new file but not vice
'versa.  To make sure the browser always downloads from the server,
'cache_version is use.  Setting this will force the broswer not to use the
'latest file in the cache.
'The combination of the archive, cache_option and cache_archive are
'unpredictable.  I wonder is cache_option no long supported base on the above
'document.

'Java Web Start/JNLP
'   <resources>
'      <j2se href="http://java.sun.com/products/autodl/j2se" version="1.6.0_18+" />
'      <jar href="http://a-mx3054a-90145/appletVnc.jar" main="true" version="1.0.0.1" />
'   </resources>
'Version in JWS couldn't be implemented because it doesn't knows how to
'download the file if is not in the cache. Some version download protocol
'needed.
%>
<!--#include file="appletsVersion.asp"-->
<%
   Dim gsUIType
   Dim gsModel
   Dim gsHostname
   Dim gsAnalogChannels
   Dim gsDigitalChannels
   Dim gsVncTile
   Dim gsVncFilename
   Dim gsJnlpFilename
   Dim gsFullJnlpFilename
   Dim gbWriteFile
   Dim goFileSystem

   gsUIType = Request.QueryString("ui")
   If (gsUIType = "") Then
      gsUIType = "0"
   End If

   gsModel = Request.QueryString("mn")
   gsHostname = Request.QueryString("hn")
   gsAnalogChannels = Request.QueryString("an")
   gsDigitalChannels = Request.QueryString("dg")
   gsVncTitle = Request.QueryString("dc")
   gsVncFilename = Request.QueryString("fn")
   gsJnlpFilename = gsHostname + "_" + gsUItype + ".jnlp"
   gsFullJnlpFilename = Server.MapPath(gsJnlpFilename)
   gbWriteFile = False

   Set goFileSystem = CreateObject("infiniiVisionWebCom.FileSystem")
   If (not goFileSystem is nothing) Then
      'Response.Write gsFullJnlpFilename & "<BR />"
      If (goFileSystem.IsFileExist(gsFullJnlpFilename) <> False) Then
         'Response.Write "file exist, check for changes <BR />"
         If (goFileSystem.OpenFileRO(gsFullJnlpFilename) <> False) Then
            If (IsJnlpFileValid(goFileSystem) = False) Then
               'Response.Write "file not valid <BR />"
               goFileSystem.CloseFile
               gbWriteFile = goFileSystem.OverwriteFile(gsFullJnlpFilename)
            Else
               goFileSystem.CloseFile
            End If

         End If
      Else
         'Response.Write "file not exist, create new file <BR />"
         gbWriteFile = goFileSystem.CreateNewFile(gsFullJnlpFilename)
      End If
   End If

   If (gbWriteFile <> False) Then
      WriteJnlpFile goFileSystem
      goFileSystem.CloseFile
   End If
   Set goFileSystem = Nothing

   Function IsJnlpFileValid(fileSystem)
      'Response.Write "CheckJnlpFile <br />"
      If (fileSystem.Find("<title>" + gsVncTitle + "</title>") = False)  Then
         'Response.Write gsVncTitle + "<br />"
         IsJnlpFileValid = False
         Exit Function
      End If

      If (fileSystem.Find("<j2se href=""http://java.sun.com/products/autodl/j2se"" version=""" + gsJREVersion + "+"" />") = False) Then
         IsJnlpFileValid = False
         Exit Function
      End If

      'If (fileSystem.Find("<jar href=""" + gsVncFilename + """ main=""true"" version=""" + gsAppletVncVersion + """ />") = False) Then
      If (fileSystem.Find("<jar href=""" + gsVncFilename + """ main=""true"" />") = False) Then
         'Response.Write gsVncFilename + "<br />"
         IsJnlpFileValid = False
         Exit Function
      End If

      If (fileSystem.Find("<argument>-NumDigitalChannels=" + gsDigitalChannels + "</argument>") = False) Then
         'Response.Write "-NumDigitalChannels=" + gsDigitalChannels + "<br />"
         IsJnlpFileValid = False
         Exit Function
      End If
      IsJnlpFileValid = True
   End Function

   Sub WriteJnlpFile(fileSystem)
      'Response.Write "WriteJnlpFile"
      fileSystem.WriteLn "<?xml version=""1.0"" encoding=""UTF-8""?>"
      fileSystem.WriteLn "<jnlp spec=""1.0+"" codebase=""http://" + gsHostname + """ href=""" + gsJnlpFilename + """ version=""" + gsAppletVncVersion + """>"
      fileSystem.WriteLn "   <information>"
      fileSystem.WriteLn "      <title>" + gsVncTitle + "</title>"
      fileSystem.WriteLn "      <vendor>Agilent Technologies</vendor>"
      fileSystem.WriteLn "   </information>"
      fileSystem.WriteLn "   <resources>"
      fileSystem.WriteLn "      <j2se href=""http://java.sun.com/products/autodl/j2se"" version=""" + gsJREVersion + "+"" />"
      'fileSystem.WriteLn "      <jar href=""" + gsVncFilename + """ main=""true"" version=""" + gsAppletVncVersion + """ />"
      fileSystem.WriteLn "      <jar href=""" + gsVncFilename + """ main=""true"" />"
      fileSystem.WriteLn "   </resources>"
      fileSystem.WriteLn "   <application-desc name=""" + gsVncTitle + """ main-class=""vncviewer.VNCViewer"">"
      fileSystem.WriteLn "      <argument>-Server=" + gsHostname + "</argument>"
      fileSystem.WriteLn "      <argument>-Port=5900</argument>"
      fileSystem.WriteLn "      <argument>-Shared=No</argument>"
      fileSystem.WriteLn "      <argument>-PreferredEncoding=hextile</argument>"
      fileSystem.WriteLn "      <argument>-AlwaysShowServerDialog=No</argument>"
      fileSystem.WriteLn "      <argument>-NumDigitalChannels=" + gsDigitalChannels + "</argument>"
      fileSystem.WriteLn "      <argument>-NumAnalogChannels=" + gsAnalogChannels + "</argument>"
      fileSystem.WriteLn "      <argument>-Model=" + gsModel + "</argument>"
      fileSystem.WriteLn "      <argument>-UIType=" + gsUIType + "</argument>"
      fileSystem.WriteLn "   </application-desc>"
      fileSystem.WriteLn "</jnlp>"
   End Sub
%>
<HTML>
<HEAD>
   <META http-equiv="Cache-Control" content="no-cache">
   <META http-equiv="Pragma" content="no-cache">
   <META http-equiv="Expires" content="0">
   <META content="text/html; charset=iso-8859-1" http-equiv="Content-Type">
   <LINK href="style.css" rel="stylesheet" title="WebEnabled" type="text/css">
   <TITLE>Remote Front Panel </TITLE>

   <SCRIPT type="text/javascript" src="utils.js"></SCRIPT>
   <SCRIPT language="JavaScript" type="text/javascript">
      <!--      hide
      var remoteHelpWindow = null;
      var goScopeInfo = new parent.ScopeInfo();
      var goLanInfo = new parent.LanInfo();
      var gsVersion = getAppletVersion(goScopeInfo.sFirmwareRev, "<%=gsAppletVncVersion%>");

      function openBrowserWindow(url)
      {
         window.open(url, 'out', 'toolbar=yes,location=yes,menubar=yes,scrollbars=yes, resizable=yes,width=640,height=400,screenX=150,screenY=150');
      }

      function getHelp()
      {
         if (!remoteHelpWindow || remoteHelpWindow.closed)
            remoteHelpWindow = window.open('help/helpRemoteFrontPanel.asp?Model=' + goScopeInfo.sModel, 'help', 'scrollbars=yes,resizable=yes,width=700,height=450,screenX=150,screenY=150, left=150,top=150');
         if (remoteHelpWindow) remoteHelpWindow.focus();
      }

      function netscapeLaunchVNC()
      {
         if (!navigator.javaEnabled())
         {
            document.write('<DIV style="background:#F0F0F0;padding:1em">' +
                           'Failed to start the Remote Front Panel applet. Java is disabled.<\/DIV>');
                           
            return;
         }

         document.write('<EMBED type="application/x-java-applet;version=<%=gsJREVersionShort%>" ',
                      'code="vncviewer/VNCViewer.class" ',
                      'width="0" height="0" align="bottom" ',
                      'archive="" ',
                      'cache_option="No" ',
                      'cache_archive="' + goScopeInfo.sVncFilename + '" ',
                      'cache_version="' + gsVersion + '" ',
                      'pluginspage="http://java.sun.com/javase/downloads/ea.jsp" ',
                      'Server="' + location.hostname + '" ',
                      'Port="5900" ',
                      'Shared="No" ',
                      'PreferredEncoding="hextile" ',
                      'NumAnalogChannels="' + goScopeInfo.sAnalogChannels + '" ',
                      'NumDigitalChannels="' + goScopeInfo.sDigitalChannels + '" ',
                      'Model="' + goScopeInfo.sModel + '" ',
                      'AlwaysShowServerDialog="No"',
                      'UIType=<%=gsUIType%>>',
                      '<NOEMBED>',
                      '<DIV style="background:#F0F0F0;padding:1em">',
                      'Failed to start the Remote Front Panel applet. This can happen when:',
                      '<UL>',
                      '   <LI>Your browser needs permission to run the Java applet. In this case, you can give your browser permission to run the applet (for example, by clicking the yellow Information bar).<\/LI>',
                      '   <BR>',
                      '   <LI>There is no <%=gsJREVersionLong & " "%> or greater installed. In this case, you can download and install the latest Java SE Runtime Environment from <A HREF="http:\/\/java.com\/en\/download\/index.jsp" target="_blank">Free Java Download.<\/A><\/LI>',
                      '<\/UL>',
                      '<\/DIV>',
                      '<\/NOEMBED>',
                      '<\/EMBED>');
      }

      function mieLaunchApplet()
      {
         var _nAgt = navigator.userAgent;
         var _fullVersion = 0;
         var _majorVersion = 0;

         // In Internet Explorer, the true version is after "MSIE" in userAgent
         if ((verOffset = _nAgt.indexOf("MSIE")) != -1)
         {
            _fullVersion = parseFloat(_nAgt.substring(verOffset + 5));
            _majorVersion = parseInt('' + _fullVersion);
         }

         if (_majorVersion == 6)
         {
            //this fixes the KB912945 click to activate problem
            document.write('<NOSCRIPT class=clickfix><OBJECT style=\"display:none\">');
         }

         document.write('<OBJECT ',
                      'classid="<%=gsClassid%>"',
                      'codebase="<%=gsCodebase%>"',
                      'width="1" height="0" align="bottom">',
                      '<PARAM NAME="archive" VALUE="">',
                      '<PARAM NAME="cache_option" VALUE="No">',
                      '<PARAM NAME="cache_archive" VALUE="' + goScopeInfo.sVncFilename + '">',
                      '<PARAM NAME="cache_version" VALUE="' + gsVersion + '">',
                      '<PARAM NAME="code" VALUE="vncviewer/VNCViewer.class">',
                      '<PARAM NAME="Server" VALUE = "' + location.hostname + '">',
                      '<PARAM NAME="Port" VALUE = "5900">',
                      '<PARAM NAME="Shared" VALUE="No">',
                      '<PARAM NAME="PreferredEncoding" VALUE ="hextile">',
                      '<PARAM NAME="NumAnalogChannels" VALUE="' + goScopeInfo.sAnalogChannels + '">',
                      '<PARAM NAME="NumDigitalChannels" VALUE="' + goScopeInfo.sDigitalChannels + '">',
                      '<PARAM NAME="Model" VALUE="' + goScopeInfo.sModel + '">',
                      '<PARAM NAME="AlwaysShowServerDialog" VALUE="No">',
                      '<PARAM NAME="scriptable" VALUE="true">',
                      '<PARAM NAME="UIType" VALUE="<%=gsUIType%>">',
                      '<DIV style="background:#F0F0F0;padding:1em">',
                      'Failed to start the Remote Front Panel applet. This can happen when:',
                      '<UL>',
                      '   <LI>Your browser needs permission to run the Java applet. In this case, you can give your browser permission to run the applet (for example, by clicking the yellow Information bar).<\/LI>',
                      '   <BR>',
                      '   <LI>There is no <%=gsJREVersionLong & " "%> or greater installed. In this case, you can download and install the latest Java SE Runtime Environment from <A HREF="http://java.com/en/download/index.jsp" target="_blank">Free Java Download.<\/A><\/LI>',
                      '<\/UL>',
                      '<\/DIV>',
                      '<\/OBJECT>');

         if (_majorVersion == 6)
         {
            //this fixes the KB912945 click to activate problem
            document.write('<\/OBJECT><\/NOSCRIPT>');
         }
      }                                                                                                                                                                                                                

      function displayApplet()
      {
         var _app = navigator.appName;

         if (_app == 'Netscape')
         {
            netscapeLaunchVNC();
         }
         else if (_app == 'Microsoft Internet Explorer')
         {
            mieLaunchApplet();
         }
         else
         {
            document.write('<P>Sorry, unsupported browser.<\/P>');
         }
      }

      function writeJnlpLink()
      {
         var browser = getBrowser(navigator.userAgent);

         if (browser == "MSIE" || browser == "Firefox")
         {
            document.write('<BR><FONT color="#FF0000"><B>Tips<\/B><\/FONT>: <BR>' +
                           'You can now launch the Remote Front Panel without starting a browser. ' +
                           '<BR />Simply create a shortcut from this hyperlink <A href="<%=gsJnlpFilename%>" ' +
                           'onmouseover="window.status=\'Java Web Start Remote Front Panel\'; return true;"' +
                           'onmouseout="window.status=\'\'; return true;">' +
                           goLanInfo.sDescription + ' Remote Front Panel<\/A> by right clicking on it, ' +
                           'select <I>Copy Shortcut<\/I>, then right click on your PC Desktop ' +
                           'and select <I>Paste Shortcut<\/I>.  It is recommended to use Internet Explorer ' +
                           'as the default browser with this capability.<BR>');
         }
      }

      -->
   </SCRIPT>

</HEAD>
<BODY>
   <TABLE border="0" cellpadding="12" cellspacing="0" width="100%">
      <TR align="left" valign="TOP">
         <TD align="RIGHT" valign="BOTTOM" width="800">
            <DIV align="LEFT">
               <TABLE border="0" cellpadding="5" cellspacing="0" width="800">
                  <TR>
                     <TD width="100%">
                        <H3>
                           <SPAN>Remote Front Panel </SPAN>
                        </H3>
                        <HR noshade size="1">
                        The Remote Front Panel allows you to control your
                        <SCRIPT language="JavaScript" type="text/javascript">
                           document.write(goScopeInfo.sModel)
                        </SCRIPT>
                        &nbsp;oscilloscope using a mouse and keyboard.  It also allows keyboard entry for text input like label or filename.
                        <BR>
                        <BR>
                        If the Remote Front Panel window does not appear in a few seconds, press the
                        <A href="#" onclick="getHelp()" onmouseout="window.status=''; return true;"
                           onmouseover="window.status='Help with this Page'; return true;">Help with this Page</A>
                        &nbsp;button for more information.
                        <BR>
                        <BR>
                        <SCRIPT language="JavaScript" type="text/javascript">
                           displayApplet();
                        </SCRIPT>
                        <SCRIPT language="JavaScript" type="text/javascript">
                           writeJnlpLink();
                        </SCRIPT>
<%If (gsUIType = "1") Then %>
<!--#include file="toolbarHelp.asp"-->
<%End If%>
                        <P>
                           The Remote Front Panel window uses the VNC Viewer Free Edition
                           <BR>
                           Copyright (C) 2002-2005 RealVNC Ltd.
                           <BR>
                           See <A href="#" onclick="openBrowserWindow('http://www.realvnc.com/')" onmouseout="window.status=''; return true;"
                              onmouseover="window.status='www.realvnc.com'; return true;">http://www.realvnc.com</A>
                           &nbsp;for information on VNC.
                        </P>
                     </TD>
                  </TR>
               </TABLE>
            </DIV>
         </TD>
      </TR>
   </TABLE>
   <!-- this script is used to workaround KB912945 click to activate problem -->

   <SCRIPT language="JScript" type="text/jscript" src="/ClickFix.js">
   </SCRIPT>

</BODY>
</HTML>
