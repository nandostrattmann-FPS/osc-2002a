<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<%@  language="VBSCRIPT" %>
<HTML>
<HEAD>
   <%
   Dim goScopeReport
   Dim goArrCalStatus
   Dim goArrCalInfo
   Dim gsCalStatus
   
   gsCalStatus = "Unknown"
   Set goScopeReport = CreateObject("infiniiVisionWebCom.ScopeReport")
   If (Not goScopeReport Is Nothing) Then
      goArrCalStatus  = Split(goScopeReport.Calibration, ",")
      Set gsScopeReport = Nothing
   End If
   %>  
   <TITLE>cal info </TITLE>
   <META content="text/html; charset=iso-8859-1" http-equiv="Content-Type">
   <LINK href="style.css" rel="stylesheet" title="WebEnabled" type="text/css">
</HEAD>
<BODY>
   <TABLE border="0" cellpadding="0" cellspacing="0" width="100%">
      <TR>
         <TD>
            <TABLE border="0" cellpadding="5" cellspacing="0" width="480">
               <TR>
                  <TD>
                     <H3 align="center">
                        <BR>
                        Calibration Status
                     </H3>
                  </TD>
               </TR>
               <TR>
                  <TD>
                     <TABLE border="0" cellpadding="0" cellspacing="0" width="100%">
                        <TR>
                           <TD class="dataGray" width="100%">
                              <TABLE border="2" cellpadding="5" cellspacing="0" width="100%">
                                 <TR>
                                    <TD class="dataGray">
                                       <TABLE border="1" cellpadding="3" cellspacing="1" width="100%">
                                          <COL width="35%">
                                          <COL width="65%">                                         
<%
   gsClass = "dataWhite"
   For Each gsCalStatus In goArrCalStatus
      goArrCalInfo = Split(gsCalStatus, "|")
%>
                                          <TR>
                                             <TD class="labelBlue" >
                                                <%=goArrCalInfo(0)%>
                                             </TD>
                                             <TD class="<%=gsClass%>" style="text-align:left" >
                                                <%=goArrCalInfo(1)%>
                                             </TD>
                                          </TR>
<%
      If (gsClass = "dataWhite") Then
         gsClass = "dataGray"
      Else
         gsClass = "dataWhite"
      End If
   Next
%>
                                       </TABLE>
                                    </TD>
                                 </TR>
                              </TABLE>
                           </TD>
                        </TR>
                     </TABLE>
                  </TD>
               </TR>
            </TABLE>
         </TD>
      </TR>
   </TABLE>
</BODY>
</HTML>
