var firstTime=true;function initUI(b){if(b.length<100){connected=true;var a=b.split(" ",25);var c=a[1];if(c.charAt(7)=="2"){document.getElementById("kbchannels").src="image/kbLabel2ChanWeb.png";document.getElementById("fourchancontrols").innerHTML=""}if(c.charAt(0)=="M"){document.getElementById("dsoMso").innerHTML="Mixed Signal Oscilloscope";document.getElementById("modelNum").innerHTML="MSO-X "}else{document.getElementById("dsoMso").innerHTML="Digital Storage Oscilloscope";document.getElementById("modelNum").innerHTML="DSO-X "}document.getElementById("modelNum").innerHTML+=c.charAt(4)+c.charAt(5)+c.charAt(6)+c.charAt(7)+"A";if(c.charAt(4)=="2"){document.getElementById("sampleRate").innerHTML="2 GSa/s"}else{if(c.charAt(5)!="1"){document.getElementById("sampleRate").innerHTML="4 GSa/s"}}if(c.charAt(5)=="1"){document.getElementById("bandwidth").innerHTML="1 GHz";document.getElementById("sampleRate").innerHTML="5 GSa/s"}else{if(c.charAt(6)=="0"){document.getElementById("bandwidth").innerHTML="70 MHz"}else{if(c.charAt(6)=="1"){document.getElementById("bandwidth").innerHTML="100 MHz"}else{if(c.charAt(6)=="2"){document.getElementById("bandwidth").innerHTML="200 MHz"}else{if(c.charAt(6)=="3"){document.getElementById("bandwidth").innerHTML="350 MHz"}else{if(c.charAt(6)=="5"){document.getElementById("bandwidth").innerHTML="500 MHz"}}}}}}if(navigator.platform.match("iPad")&&!window.navigator.standalone&&firstTime){alert("iPad Users:\nTo view this remote front panel in fullscreen mode, tap on the swooshing arrow icon in the Safari menu bar.  Then tap 'Add to Home Screen' to make a link icon to this page on your home screen.  You may then launch this remote front panel in fullscreen mode from that icon.");firstTime=false}}}var timeDown;function bUD(e,a,f){var c=new Date();if(f){timeDown=c.getTime()}else{var b=c.getTime();if(b-timeDown>1000){rfb.sendKey(e,a,0,false)}else{rfb.sendKey(e,a)}}}function initRFB(){rfb=new RFB({target:$D("noVNC_canvas"),encrypt:WebUtil.getQueryVar("encrypt",false),true_color:WebUtil.getQueryVar("true_color",true),local_cursor:WebUtil.getQueryVar("cursor",true),shared:WebUtil.getQueryVar("shared",true),view_only:WebUtil.getQueryVar("view_only",false),updateState:updateState,onPasswordRequired:passwordRequired});initialised=true;rfb.connect(location.hostname,5850,"","")}var imgLoaded=false;function imageLoaded(){imgLoaded=true;checkImages();setTimeout(function(){document.getElementById("splash").style.left="1024px";if((navigator.appVersion.match("Safari")&&!navigator.appVersion.match("Chrome"))||navigator.appVersion.match("iPad")){setTimeout(function(){document.getElementById("runStopButton").style.visibility="visible";document.getElementById("singleButton").style.visibility="visible"},1000)}else{document.getElementById("runStopButton").style.visibility="visible";document.getElementById("singleButton").style.visibility="visible"}setTimeout(function(){document.getElementById("splash").style.visibility="hidden";document.getElementById("splash").style.width="0px";document.getElementById("splash").style.zIndex="-1";document.getElementById("logos").style.left="-500px";document.getElementById("logos").style.width="0px";document.getElementById("loadPic").style.left="-500px";document.getElementById("loadPic").style.width="0px";document.getElementById("noVNC_status").style.left="-500px";document.getElementById("noVNC_status").style.width="0px"},1000)},200)}function IsImageOk(a){if(!a.complete){return false}if(typeof a.naturalWidth!="undefined"&&a.naturalWidth==0){return false}return true}function checkImages(){for(var a=0;a<document.images.length;a++){if(!IsImageOk(document.images[a])){var b=document.images[a].src;document.images[a].src="";document.images[a].src=b}}}function saveCanvasImage(){document.getElementById("framediv").innerHTML='<iframe style="width: 810px; height: 600px;" src="getImage.asp?inv=true"/>';document.getElementById("framediv").style.width="1024px";document.getElementById("framediv").style.left="15px";document.getElementById("hideButton").style.left="15px";document.getElementById("hideButton").style.width="49px";document.getElementById("imgcapture").style.width="1044px";document.getElementById("imgcapture").style.visibility="visible";if((navigator.appVersion.match("Safari")&&!navigator.appVersion.match("Chrome"))||navigator.appVersion.match("iPad")){document.getElementById("runStopButton").style.visibility="hidden";document.getElementById("singleButton").style.visibility="hidden"}document.getElementById("imgcapture").style.left="0px";noClickEnabled=false}function hideImgCapture(){document.getElementById("imgcapture").style.left="1024px";noClickEnabled=true;if((navigator.appVersion.match("Safari")&&!navigator.appVersion.match("Chrome"))||navigator.appVersion.match("iPad")){setTimeout(function(){document.getElementById("runStopButton").style.visibility="visible";document.getElementById("singleButton").style.visibility="visible"},1000)}setTimeout(function(){document.getElementById("imgcapture").style.visibility="hidden";document.getElementById("imgcapture").style.width="0px";document.getElementById("framediv").innerHTML="";document.getElementById("framediv").style.width="0px";document.getElementById("framediv").style.left="-500px";document.getElementById("hideButton").style.left="-500px";document.getElementById("hideButton").style.width="0px"},1000)}function NoClickDelay(a){this.element=typeof a=="object"?a:document.getElementById(a);this.element.addEventListener("touchstart",this,false)}var startx,starty,noClickEnabled=true;NoClickDelay.prototype={handleEvent:function(a){if(noClickEnabled){switch(a.type){case"touchstart":setTimeout(this.onTouchStart(a),30);break;case"touchmove":this.onTouchMove(a);break;case"touchend":this.onTouchEnd(a);break}}},onTouchStart:function(a){if(!a.targetTouches[1]){a.preventDefault();this.moved=false;startx=a.targetTouches[0].clientX;starty=a.targetTouches[0].clientY;this.theTarget=document.elementFromPoint(a.targetTouches[0].clientX,a.targetTouches[0].clientY);if(this.theTarget.nodeType==3){this.theTarget=theTarget.parentNode}this.theTarget.className+=" pressed";this.element.addEventListener("touchmove",this,false);this.element.addEventListener("touchend",this,false);var b=document.createEvent("MouseEvents");b.initEvent("mousedown",true,true);this.theTarget.dispatchEvent(b)}},onTouchMove:function(a){if(a.targetTouches[0].clientX-startx>50||startx-a.targetTouches[0].clientX>50||a.targetTouches[0].clientY-starty>50||starty-a.targetTouches[0].clientY>50){this.moved=true}this.theTarget.className=this.theTarget.className.replace(/ ?pressed/gi,"")},onTouchEnd:function(a){this.element.removeEventListener("touchmove",this,false);this.element.removeEventListener("touchend",this,false);this.theTarget.className=this.theTarget.className.replace(/ ?pressed/gi,"");var b=document.createEvent("MouseEvents");b.initEvent("mouseup",true,true);this.theTarget.dispatchEvent(b);if(!this.moved&&this.theTarget){b=document.createEvent("MouseEvents");b.initEvent("click",true,true);this.theTarget.dispatchEvent(b)}started=false;this.theTarget=undefined}};