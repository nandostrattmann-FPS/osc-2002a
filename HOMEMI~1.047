<TABLE border="0" cellpadding="0" cellspacing="2" width="800">
   <TR>
      <TD align="RIGHT" width="800">
         <DIV align="LEFT">
            <TABLE border="0" cellpadding="5" cellspacing="0" width="790">
               <TR>
                  <TD width="450">
                     <HR noshade size="1">
                     <TABLE border="0" cellpadding="5" cellspacing="1" width="100%">
                        <TR>
                           <TD class="labelBlue" width="42%">
                              Firmware Revision </TD>
                           <TD class="dataWhite" width="58%">
                              <%=goScopeInfo.FirmwareRev%>
                           </TD>
                        </TR>
                        <TR>
                           <TD class="labelBlue">
                              Ethernet (MAC) Address </TD>
                           <TD class="dataGray">
                              <%=goScopeInfo.MacAddress%>
                           </TD>
                        </TR>
                        <TR>
                           <TD class="labelBlue">
                              IPv6 Addresses</TD>
                           <TD class="dataWhite">
                              <%IF Len(goScopeInfo.ipv6GlobalAddress) > 0 THEN%>
                              [<%=goScopeInfo.ipv6GlobalAddress%>]<BR/>
                              <%END IF%>
                              [<%=goScopeInfo.ipv6LocalAddress%>]
                           </TD>
                        </TR>
                        <TR>
                           <TD class="labelBlue">
                              SCPI TCP/IP Socket Port </TD>
                           <TD class="dataGray">
                              5025
                           </TD>
                        </TR>
                        <TR>
                           <TD class="labelBlue">
                              SCPI Telnet Port </TD>
                           <TD class="dataWhite">
                              5024
                           </TD>
                        </TR>
                        <TR>
                           <TD class="labelBlue">
                              VISA USB Connect String </TD>
                           <TD class="dataGray">
                              <%=goScopeInfo.VisaUsbString%>
                           </TD>
                        </TR>
                        <TR>
                           <TD class="labelBlue">
                              SICL Interface Name </TD>
                           <TD class="dataWhite">
                              <%=goScopeInfo.SiclName%>
                           </TD>
                        </TR>
                        <TR>
                           <TD class="labelBlue">
                              GPIB Address </TD>
                           <TD class="dataGray">
                              <%=goLanInfo.GpibAddress%>
                           </TD>
                        </TR>
                        <TR>
                           <TD class="labelBlue">
                              LXI Class </TD>
                           <TD class="dataWhite">
                              C </TD>
                        </TR>
                        <TR>
                           <TD class="labelBlue">
                              LXI Version </TD>
                           <TD class="dataGray">
                              1.4 LXI Core 2011</TD>
                        </TR>
                        <TR>
                           <TD class="labelBlue">
                              Auto-MDIX Capable </TD>
                           <TD class="dataWhite">
                              Yes </TD>
                        </TR>
                     </TABLE>
                  </TD>
                  <TD width="275">
                  </TD>
               </TR>
            </TABLE>
         </DIV>
      </TD>
   </TR>
</TABLE>
