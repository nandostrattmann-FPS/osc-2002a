A { 
    font-family: Arial, Helvetica, sans-serif; 
    font-size: 12px; 
    color: #003399; 
    font-weight: normal; 
    font-style: normal; 
    text-decoration: underline; }
A.weblink {
	font-family: Arial, Helvetica, sans-serif;
	font-size: 12px;
	color: white;
	text-decoration: none; }
	input {font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: normal; font-style: normal;text-decoration: none; text-align: center; vertical-align: middle; margin: 0;}
BODY, P { font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: black; font-weight: normal; font-style: normal; background-color: white; text-decoration: none; vertical-align: middle; margin: 0; margin-left: 0.25in;  margin-bottom: 0.1in; }
H1 { font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-weight: bold; background-color: white; color: black; vertical-align: top; margin: 0; margin-bottom: 0.1in; margin-top: 0.4in; margin-left: 0; padding: 0; }
H2 { font-family: Arial, Helvetica, sans-serif; font-size: 10pt; font-weight: bold; background-color: white; color: #336699; vertical-align: top; margin: 0; margin-bottom: 0.05in; margin-top: 0.2in; margin-left: 0.25in; padding: 0; }
