	<!-- FrontPanel references -->
    <script src="frontpanel.min.js"></script>
	<script src='include/vnc.min.js'></script>
    <script>        
		/*jslint white:false */
		/*global window,$,Util,RFB,*/
        "use strict";       
		var rfb,connected = false,initialised = false,img,Websock_native=false;
	    window.onload = function () {	
			if (navigator.appName.match("Opera") || navigator.appVersion.match("Silk") || navigator.appVersion.match("TouchPad")) {
				document.getElementById("runStopButton").style.width = "89px";
				document.getElementById("singleButton").style.width = "89px";
				document.getElementById("singleButton").style.left = "912px";
				document.getElementById("runStopPic").style.left = "7px";
				document.getElementById("singlePic").style.left = "21px";
			}	
			if (navigator.appVersion.match("MSIE 7.0") &&
				navigator.appVersion.match("Trident/6")) {
				document.getElementById("loadPic").src = "image/splashSorry.png";
				document.getElementById("noVNC_status").innerHTML = "Click <a href=\"javascript:window.open(\'ieCompat.html\');window.close();\"\>here</a\> for instructions on fixing your internet options for use with this page";
			} else if ((navigator.appVersion.match("MSIE 9.0") ||
				 navigator.appVersion.match("MSIE 8.0") ||
				 navigator.appVersion.match("MSIE 7.0") ||
				 navigator.appVersion.match("MSIE 6.0")) &&
				!navigator.appVersion.match("Trident/6")) {
				document.getElementById("loadPic").src = "image/splashSorry.png";
			} else {
				if (window.WebSocket) {
					Websock_native = true;
				} else if (window.MozWebSocket) {
					Websock_native = true;
					window.WebSocket = window.MozWebSocket;
				} else {
					/* no builtin WebSocket so load web_socket.js */
				}

				if (location.hostname.charAt(7) == "2" && location.hostname.charAt(0) == "a") {
					document.getElementById("kbchannels").src = "image/kbLabel2ChanWeb.png";
					document.getElementById("fourchancontrols").innerHTML = "";
				}
				img = new Image();
				img.src = "image/entryLed.png";
				setTimeout(function() { if (!initialised) location.reload(true);},4000);
				initRFB();
			}
			new NoClickDelay(document.getElementById('body'));
		};
		
		window.onunload = function() {
			rfb.disconnect();
		};

		function passwordRequired(rfb) {}
		var androidMessageFirstTime = true;
		function updateState(rfb,state,oldstate,msg) {
			if (!connected && typeof msg != "undefined") {
				document.getElementById("noVNC_status").innerHTML = msg;
				if (msg == "Connect timeout" && navigator.appVersion.match("Android") && !navigator.appVersion.match("Opera") && androidMessageFirstTime) {
					alert("If you are having trouble connecting from this web browser, try the Opera Mobile web browser available in the Google Play Store.");
					androidMessageFirstTime = false;
				}
			}
			if (typeof msg != "undefined") {
				if (msg.match("disconnected") || msg.match("timeout") || msg.match("error")) {
					setTimeout(function() {rfb.connect(location.hostname,5850,"","");},500);
					connected = false;
				} else if (msg.match("Connected")) {
					connected = true;
					setTimeout(function() {if(!imgLoaded)imageLoaded();},1000);
				}
			}
		}
	</script>	
</body>
</html>
