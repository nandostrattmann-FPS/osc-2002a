    href="<URL TO GO TO WHEN CLICKED>"
    onClick="tabstrip.MouseClick('<new image name>'); <any other javascript>"
    onMouseOver="tabstrip.MouseOver('<new image name>'); <any other javascript>"
    onMouseOut="tabstrip.MouseOut('<new image name>');<any other javascript>"
    >
    <img
    src="navbar/<new image gif file>.gif" border="0" name="help" width="120"
    ></a></td>
    </tr>
    ///UNCOMMENT -->
   </TABLE>
</BODY>
</HTML>
