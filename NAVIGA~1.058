<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<HTML>
<HEAD>
   <TITLE>navigation </TITLE>
   <META content="text/html; charset=iso-8859-1" http-equiv="Content-Type">
   <LINK href="style.css" rel="stylesheet" title="WebEnabled" type="text/css">

   <SCRIPT language="javascript" type="text/javascript">
      <!-- hide from older browsers
      var goScopeInfo = new parent.ScopeInfo();
      // Tabstrip Framework
      // This file implements a Tabbed-navigation bar framework
      // You can Construct a Tabstrip as demonstrated in 
      // navigation.html
      // !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
      // NOTE:  YOU SHOULD NEVER NEED TO EDIT THIS FILE
      
      ///////////////////////////////////////////////////////////////////////////////
      // Class PreloadedImage
      ///////////////////////////////////////////////////////////////////////////////
      // Member functions:
      //		PreloadedImage(url);  // constructor
      //      OnLoad();			  // called when image is preloaded
      // Useful (public) member variables:
      //		pImage			// pointer to an Image object used to preload
      //      src				// the url for the image loaded   
      ///////////////////////////////////////////////////////////////////////////////
      
      // Construct a preloaded image, given the URL.  
      // The callback is called when the image is loaded
      function PreloadedImage(url)
      {
        if (PreloadedImage.arguments.length == 0) return;

        this.pImage = new Image();  
        this.loaded = true;
        this.pImage.onload = this.OnLoad;
        this.pImage.src = url;
        this.src = url;   
      }
      
      // Called when one of the tab's images is loaded
      // when all are loaded, the tab is considered "loaded"
      function PreloadedImage_OnLoad()
      {
        this.loaded = true;
      }
      
      // PreloadedImage prototypes
      new PreloadedImage();
      PreloadedImage.prototype.OnLoad = PreloadedImage_OnLoad;
      
      
      
      //-mch I don't know how to make real constants in JS, so ...
      var TS_NORMAL = 0;                                   // normal tab sate	
      var TS_ROLLOVER = 1;                                 // mouse is over tab
      var TS_SELECTED = 2;                                 // tab is selected
      
      
      Tab.Selectable = 0;
      Tab.Doit = 1;
      
      ///////////////////////////////////////////////////////////////////////////////
      // Class Tab
      ///////////////////////////////////////////////////////////////////////////////
      // Member functions:
      //		Tab(ImageName,		// Constructor
      //			 NormalURL,
      //			 RolloverURL,
      //			 SelectedURL,
      //			 TabStyle);				
      //		Load();				// pre-load all images now
      //      NormalImage();		// switch tab to the normal state
      //      SelectedImage();	// switch tab to the selected state
      //      RolloverImage();	// switch tab to the rollover state
      // Useful (public) member variables:
      //		loaded				// are all tab images fully pre-loaded?
      //      src					// the url for the image loaded   
      ///////////////////////////////////////////////////////////////////////////////
      
      // to check if the tab is fully loaded
      function Tab_CheckLoaded()
      {
        if (!docLoaded) return;
        if (this.pRolloverImage.loaded &&
            this.pNormalImage.loaded && 
            this.pSelectedImage.loaded)
        {
          this.loaded = true;       
          this.pDocImage = document.images[this.imageName];
          if (this.pDocImage) 
            this.pDocImage.alt = this.pDocImage.alt.replace("[MODEL]", goScopeInfo.sModel);
          else
            alert("invalid image: " + this.imageName);
        }
      }
      
      // to change the image that the tab displays
      function Tab_ChangeImage(pImage)
      {
        if (!this.loaded)
        {                                                  // no dynamics until loaded
          this.CheckLoaded();   
          if (!this.loaded) return;
        }

        if (!this.pDocImage) return;
        this.pDocImage.src = pImage.src;
      }
      
      // to show the tab's normal image
      function Tab_NormalImage()
      {
        this.state = TS_NORMAL;
        this.ChangeImage(this.pNormalImage);
      }
      
      // to show the tab's selected image (the tab is selected)
      function Tab_SelectedImage()
      {
        this.state = TS_SELECTED;
        this.ChangeImage(this.pSelectedImage);
      }
      
      // to show the tab's rollover image
      function Tab_RolloverImage()
      {
        this.state = TS_ROLLOVER;
        this.ChangeImage(this.pRolloverImage);
      }
      
      // Tells whether this tab can be selected, or if it is just a "do-it" (eg print)
      function Tab_CanSelect()
      {
        return(this.style == Tab.Selectable);
      }
      
      // tell the tab to preload it's images
      function Tab_Load()
      {
        this.pNormalImage = new PreloadedImage(this.normalURL);
        this.pRolloverImage = new PreloadedImage(this.rolloverURL);
        this.pSelectedImage = new PreloadedImage(this.selectedURL);
      }
      
      // Construct a new Tab
      function Tab(ImageName,
                   NormalURL,
                   RolloverURL,
                   SelectedURL,
                   TabStyle) 
      {
        this.imageName = ImageName;
        this.loaded = false;    
        this.state = TS_NORMAL;
        this.selectedURL = SelectedURL;
        this.normalURL = NormalURL;
        this.rolloverURL = RolloverURL;   
        this.style = TabStyle;
      }
      
      // tab prototypes
      new Tab(0,0,0,0);
      Tab.prototype.ChangeImage = Tab_ChangeImage;
      Tab.prototype.NormalImage = Tab_NormalImage;
      Tab.prototype.RolloverImage = Tab_RolloverImage;
      Tab.prototype.SelectedImage = Tab_SelectedImage;
      Tab.prototype.Load = Tab_Load;
      Tab.prototype.CheckLoaded = Tab_CheckLoaded;
      Tab.prototype.CanSelect = Tab_CanSelect;
      
      ///////////////////////////////////////////////////////////////////////////////
      // Class TabStrip
      ///////////////////////////////////////////////////////////////////////////////
      // Member functions:
      //		TabStrip(Tabs...);  // Constructor
      //		SelectedTab();		// return the name of the document image for 
      //							// the currently selected tab
      //      MouseOver(tabname);	// Process a mouseover event at the given tabname
      //      MouseClick(tabname);// Process a mouseclick event at the given tabname
      //      MouseOut(tabname);  // Process a mouseout event at the given tabname
      //
      // Useful (public) member variables:
      // (none)
      ///////////////////////////////////////////////////////////////////////////////
      
      // the TabStrip Constructor
      // This function takes an arbitrarily large list of 
      // Tab objects, and handles the state dynamics of this
      // group as if it were a tab-strip. (eg the nav-bar)
      function TabStrip()
      {
        var args = TabStrip.arguments;
        if (args.length == 0) return;
        var arg;
        var i;
        var pImage;
        var imgName;
        this.TabArray = new Object();
        
        for (i=0; i < args.length; i++)
        {
          
          imgName = args[i].imageName;
          if (i ==0) this.activeTab = imgName;
          this.TabArray[imgName] = args[i];
          this.TabArray[imgName].Load();
        }
        
      }
      
      // returns the currently selected tab in the strip
      function TabStrip_SelectedTab()
      {
        return this.activeTab;  
      }
      
      // processes a mouse over event for a particular tab
      function TabStrip_MouseOver(tabname)
      {
        if (!this.TabArray[tabname]) return;

        // if tab isn't selected, highlight (rollover) it	
        if (this.SelectedTab() != tabname)
        {
          this.TabArray[tabname].RolloverImage();
        }

      }
      
      // processes a mouse out event for a particular tab
      function TabStrip_MouseOut(tabname)
      {
        var pTab; 
        // if the tab isn't selected return from rollover to normal
        if (this.SelectedTab() != tabname)
        {
          pTab = this.TabArray[tabname];
          if (pTab) pTab.NormalImage();
        }
      }
      
      // processes a mouse click event for a particular tab
      function TabStrip_MouseClick(tabname)
      {
        var OldTab = this.TabArray[this.SelectedTab()];
        var NewTab = this.TabArray[tabname];
        if (! (OldTab && NewTab)) return;

        if (NewTab.CanSelect())
        {                                                  // select new tab			
          this.activeTab = tabname;   
          OldTab.NormalImage();
          NewTab.SelectedImage();   
        }
        else
        {                                                  // just return the "do-it" tab to normal after the click						
          NewTab.NormalImage();
        }   
        
      }
      
      // TabStrip prototypes
      new TabStrip();
      TabStrip.prototype.MouseClick = TabStrip_MouseClick;
      TabStrip.prototype.MouseOver = TabStrip_MouseOver;
      TabStrip.prototype.MouseOut = TabStrip_MouseOut;
      TabStrip.prototype.SelectedTab = TabStrip_SelectedTab;
      
      //-->
   </SCRIPT>

   <SCRIPT language="javascript" type="text/javascript">
      <!-- hide from older browsers
      var docLoaded = false;                               // has the document finished loading?
      
      /////////////////////////////////////////////////////////////////////////
      // User Configuration Area for the Tabbed Navigation Bar
      /////////////////////////////////////////////////////////////////////////
      
      // Add any new buttons to the this list
      
      var tabstrip = new TabStrip(
                                 new Tab("welcome",        // name of image in document
                                         "navbar/welcome.gif",  // normal image url
                                         "navbar/welcome-over.gif",  // rollover image url
                                         "navbar/welcome-down.gif",  // selected image url
                                         Tab.Selectable),  // style (Selectable or Doit)
                                 
                                 new Tab("info",           // name of image in document
                                         "navbar/utilities.gif",  // normal image url
                                         "navbar/utilities-over.gif",  // rollover image url
                                         "navbar/utilities-down.gif",  // selected image url
                                         Tab.Selectable),  // style (Selectable or Doit)
                                 
                                 new Tab("remote",         // name of image in document
                                         "navbar/remote-only.gif",  // normal image url
                                         "navbar/remote-over.gif",  // rollover image url
                                         "navbar/remote-down.gif",  // selected image url
                                         Tab.Selectable),  // style (Selectable or Doit)

                                 new Tab("saverecall",         // name of image in document
                                         "navbar/saverecall.gif",  // normal image url
                                         "navbar/saverecall-over.gif",  // rollover image url
                                         "navbar/saverecall-down.gif",  // selected image url
                                         Tab.Selectable),  // style (Selectable or Doit)
                                         
                                 new Tab("image",          // name of image in document
                                         "navbar/image.gif",  // normal image url
                                         "navbar/image-over.gif",  // rollover image url
                                         "navbar/image-down.gif",  // selected image url
                                         Tab.Selectable),  // style (Selectable or Doit)

                                 new Tab("config",         // name of image in document
                                         "navbar/config.gif",  // normal image url
                                         "navbar/config-over.gif",  // rollover image url
                                         "navbar/config-down.gif",  // selected image url
                                         Tab.Selectable),  // style (Selectable or Doit)
                                 
                                 new Tab("status",         // name of image in document
                                         "navbar/status.gif",  // normal image url
                                         "navbar/status-over.gif",  // rollover image url
                                         "navbar/status-down.gif",  // selected image url
                                         Tab.Doit),        // style (Selectable or Doit)
                                 
                                 new Tab("print",          // name of image in document
                                         "navbar/printpage.gif",  // normal image url
                                         "navbar/printpage-over.gif",  // rollover image url
                                         "navbar/printpage.gif",  // selected image url
                                         Tab.Doit),        // style (Selectable or Doit)
                                 
                                 new Tab("help",           // name of image in document
                                         "navbar/help.gif",  // normal image url
                                         "navbar/help-over.gif",  // rollover image url
                                         "navbar/help-down.gif",  // selected image url
                                         Tab.Doit)         // style (Selectable or Doit)		
                                 );
      
      
      // set initial active image and initialize status and help windows
      document.activeImage = 'welcome';
      
      statusWindow = null;
      helpWindow = null;

      function getData()
      {
        if (window.parent.content.getData)
        {
          window.parent.content.getData();
        }
        else
        {
          alert("You must first click on the Web Control button");
        }
      }
      
      function getInformation()
      {
        window.parent.content.location = "information.asp";
      }
      
      function getStatus()
      {
        if (window.parent.content.getStatus)
        {
          window.parent.content.getStatus();
        }
        else
        {
          if (!statusWindow || statusWindow.closed)
          {
            statusWindow = window.open('networkStatus.asp?Model=' + goScopeInfo.sModel, 
                                       'networkStatus', 
                                       'scrollbars=no,resizable=yes,width=500,height=550,screenX=150,screenY=150,left=150,top=150');
          }

          if (statusWindow)
          {
            statusWindow.focus();
          }
        }
      }
      
      function printContent()
      {
        window.parent.content.focus();
        
        if (window.parent.content.printContent)
          window.parent.content.printContent();
        else if (window.parent.content.print)
          window.parent.content.print();
        else
          alert("Your browser cannot print from this button.  Please use your browser's print button to print this page");
        window.parent.content.focus();
      }
      
      
      // If the content frame has getHelp function, call it.
      // Otherwise, open a small browser window with the indicated page.
      
      function getHelp()
      {
        if (window.parent.content.getHelp)
        {
          window.parent.content.getHelp();
        }
        else
        {
          alert("There is no help available on this page");
        }
      }
      
      ////////////////////////////////////////////////////////////////////////
      // DO NOT Edit the javscript in the section Below this line!!!!!!!!!!!!
      // Please skip to the html section to finish adding a button....
      ////////////////////////////////////////////////////////////////////////
      
      function UpdateTabs()
      {
        
        var aTab = 'welcome';
        if (window.parent.content != null)
        {
          if (window.parent.content.tabName != null)
          {
            aTab = window.parent.content.tabName;
          }
        }
        tabstrip.MouseClick(aTab);
      }
      
      ////////////////////////////////////////////////////////////////////////
      // DO NOT Edit the javscript in the section Above this line!!!!!!!!!!!!
      // Please skip to the html section to finish adding a button....
      ////////////////////////////////////////////////////////////////////////
      //-->
   </SCRIPT>

</HEAD>
<BODY onload="docLoaded = true; UpdateTabs();">
   <TABLE border="0" cellpadding="0" cellspacing="0" width="120">
      <!-- note: for some reason I don't understand, this html is very picky. 
         The </TD> need to follow the preceeding tag without any spaces or
         else the tabstrip will be rendered with gaps. So don't beautify this 
         file without checking and fixing the output -->
      <!-- medium bluebar -->
      <TR>
         <TD class="navBar">
            <IMG alt="" src="navbar/bluebar.gif" width="2" height="15"></TD>
      </TR>
      <!-- home/welcome -->
      <TR>
         <TD class="navKey">
            <A href="home.html" onclick="tabstrip.MouseClick('welcome');" onmouseout="tabstrip.MouseOut('welcome');window.status=''; return true;"
               onmouseover="tabstrip.MouseOver('welcome');window.status='Welcome'; return true;"
               target="content">
               <IMG alt="Welcome to the web interface to your [MODEL]" src="navbar/welcome.gif"
                  border="0" name="welcome"></A></TD>
      </TR>
      <!-- wide bluebar -->
      <TR>
         <TD class="navBar">
            <IMG alt="" src="navbar/bluebar.gif" width="2" height="30"></TD>
      </TR>
      <!-- remote control -->
      <TR>
         <TD class="navKey">
            <A href="remoteApplet.asp" onclick="tabstrip.MouseClick('remote');" onmouseout="tabstrip.MouseOut('remote');window.status=''; return true;"
               onmouseover="tabstrip.MouseOver('remote');window.status='Browser Web Control'; return true;"
               target="content">
               <IMG alt="Control and access your [MODEL]" src="navbar/remote-only.gif"
                  border="0" name="remote"></A></TD>
      </TR>
      <!-- narrow bluebar -->
      <TR>
         <TD class="navBar">
            <IMG alt="" src="navbar/bluebar.gif" width="2" height="10"></TD>
      </TR>
      <TR>
         <TD class="navKey">
            <A href="saveRecall.asp" onclick="tabstrip.MouseClick('saverecall')" onmouseout="tabstrip.MouseOut('saverecall');window.status=''; return true;"
               onmouseover="tabstrip.MouseOver('saverecall');window.status='Save/Recall'; return true;"
               target="content">
               <IMG alt="Save/Recall files of your [MODEL]" src="navbar/saverecall.gif"
                  border="0" name="saverecall"></A></TD>
      </TR>      
      <!-- narrow bluebar -->
      <TR>
         <TD class="navBar">
            <IMG alt="" src="navbar/bluebar.gif" width="2" height="10"></TD>
      </TR>
      <TR>
         <TD class="navKey">
            <A href="getImage.asp" onclick="tabstrip.MouseClick('image')" onmouseout="tabstrip.MouseOut('image');window.status=''; return true;"
               onmouseover="tabstrip.MouseOver('image');window.status='Get Image'; return true;"
               target="content">
               <IMG alt="Captures a picture of your [MODEL]&nbsp;screen" src="navbar/image.gif"
                  border="0" name="image"></A></TD>
      </TR>
      <!-- wide bluebar -->
      <TR>
         <TD class="navBar">
            <IMG alt="" src="navbar/bluebar.gif" width="2" height="30"></TD>
      </TR>
      <!-- get info -->
      <TR>
         <TD class="navKey">
            <A href="information.html" onclick="tabstrip.MouseClick('info');getInformation()"
               onmouseout="tabstrip.MouseOut('info');window.status=''; return true;" onmouseover="tabstrip.MouseOver('info');window.status='Instrument Utilities'; return true;"
               target="content">
               <IMG alt="Check and maintain your [MODEL]" src="navbar/utilities.gif"
                  border="0" name="info"></A></TD>
      </TR>
      <!-- narrow bluebar -->
      <TR>
         <TD class="navBar">
            <IMG alt="" src="navbar/bluebar.gif" width="2" height="10"></TD>
      </TR>
      <!-- config -->
      <TR>
         <TD class="navKey">
            <A href="viewConfig.asp" onclick="tabstrip.MouseClick('config');" onmouseout="tabstrip.MouseOut('config');window.status=''; return true;"
               onmouseover="tabstrip.MouseOver('config');window.status='Configure Network'; return true;"
               target="content">
               <IMG alt="Configure network settings of your [MODEL]" src="navbar/config.gif"
                  border="0" name="config" width="120"></A></TD>
      </TR>
      <!-- narrow bluebar -->
<!--      
      <TR>
         <TD class="navBar">
            <IMG alt="" src="navbar/bluebar.gif" width="2" height="10"></TD>
      </TR>
-->
      <!-- system status -->
<!--
      <TR>
         <TD class="navKey">
            <A href="#" onclick="tabstrip.MouseClick('status');getStatus()" onmouseout="tabstrip.MouseOut('status');window.status=''; return true;"
               onmouseover="tabstrip.MouseOver('status');window.status='Network Status'; return true;">
               <IMG alt="Display the network status of your [MODEL]" src="navbar/status.gif"
                  border="0" name="status" width="120"></A></TD>
      </TR>
-->
      <!-- narrow bluebar -->
      <TR>
         <TD class="navBar">
            <IMG alt="" src="navbar/bluebar.gif" width="2" height="10"></TD>
      </TR>
      <!-- print -->
      <TR>
         <TD class="navKey">
            <A href="#" onclick="tabstrip.MouseClick('print'); printContent(); " onmouseout="tabstrip.MouseOut('print');window.status=''; return true;"
               onmouseover="tabstrip.MouseOver('print');window.status='Print page'; return true;">
               <IMG alt="Print this page" src="navbar/printpage.gif" border="0" name="print" width="120"></A></TD>
      </TR>
      <!-- narrow bluebar -->
      <TR>
         <TD class="navBar">
            <IMG alt="" src="navbar/bluebar.gif" width="2" height="10"></TD>
      </TR>
      <!-- get help -->
      <TR>
         <TD class="navKey">
            <A href="#" onclick="tabstrip.MouseClick('help'); getHelp();" onmouseout="tabstrip.MouseOut('help');window.status=''; return true;"
               onmouseover="tabstrip.MouseOver('help');window.status='Help on this page'; return true;">
               <IMG alt="Help with this web interface" src="navbar/help.gif" border="0" name="help"
                  width="120"></A></TD>
      </TR>
      <!-- /////////////////////////////////////////////////////////////// -->
      <!-- /// ADD NEW BUTTONS HERE! ///////////////////////////////////// -->
      <!-- /////////////////////////////////////////////////////////////// -->
